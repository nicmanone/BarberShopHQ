<h1>You are welcome!</h1>
<p>Milosty prosim</p>
<form action="/visit" method="POST">
  <div class="form-group">
    <label for="exampleInputEmail1">Ваше имя</label>
    <input name="client[name]" type="text" class="form-control" id="exampleInputEmail1" value=""  placeholder="Введите ваше имя">
  </div>
  <div class="form-group">
    <label for="exampleInputEmail1">Ваше телефон</label>
    <input name="client[phone]" type="text" class="form-control" id="exampleInputEmail1" value="" placeholder="Введите ваш телефон">
  </div>
  <div class="form-group">
    <label for="exampleInputEmail1">Когда вас ждать?</label>
    <input id="datetimepicker" type="text" name="client[datastamp]" class="form-control">
  </div>
  <div class="form-group">
    <label for="exampleInputEmail1">В какой цвет хотите себя окрасить?</label>
  </div>
  <select id="color" name="client[color]">
  <option value="#7bd148">Green</option>
  <option value="#5484ed">Bold blue</option>
  <option value="#a4bdfc">Blue</option>
  <option value="#46d6db">Turquoise</option>
  <option value="#7ae7bf">Light green</option>
  <option value="#51b749">Bold green</option>
  <option value="#fbd75b">Yellow</option>
  <option value="#ffb878">Orange</option>
  <option value="#ff887c">Red</option>
  <option value="#dc2127">Bold red</option>
  <option value="#dbadff">Purple</option>
  <option value="#e1e1e1">Gray</option>
  </select>
  <button type="submit" class="btn btn-primary">Записаться</button>
</form>
<script type="text/javascript">
  $('#color').simplecolorpicker();
  jQuery('#datetimepicker').datetimepicker();
</script>
